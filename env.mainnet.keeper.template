# ═══════════════════════════════════════════════════════════════════════════════
# CryptoNova — MAINNET KEEPER .env template
# ───────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Fill in every value marked <REQUIRED>
#   2. SCP this file to VPS as /root/keeper-mainnet/.env
#      scp -i C:\Users\CryptoTech\.ssh\do_keeper env.mainnet.keeper.template root@167.99.0.250:/root/keeper-mainnet/.env
#   3. This file is COMPLETELY SEPARATE from /root/keeper/.env (testnet)
#      Do NOT touch /root/keeper/.env
# ═══════════════════════════════════════════════════════════════════════════════

# ── RPC ────────────────────────────────────────────────────────────────────────
# NOTE: scripts read BASE_SEPOLIA_RPC_URL regardless of name — for mainnet
#       just point this variable at the BASE MAINNET RPC endpoint
BASE_SEPOLIA_RPC_URL=<REQUIRED: Base MAINNET RPC, e.g. https://base-mainnet.g.alchemy.com/v2/YOUR_KEY>

# ── Addresses file (created by mainnet deploy) ──────────────────────────────
ADDRESSES_FILE=deployed_addresses_mainnet_v8_38.json

# ── Keeper wallet ────────────────────────────────────────────────────────────
# Signs performUpkeep() and rescue TXs on mainnet — must hold Base ETH for gas
# Can be the deployer key OR a dedicated keeper wallet (dedicated is safer)
# Whichever wallet you use: fund it with at least 0.1 Base ETH before enabling cron
KEEPER_PRIVATE_KEY=<REQUIRED: private key of your mainnet keeper/deployer wallet>

# ── Deployer (used by system_keeper for emergency admin calls) ───────────────
DEPLOYER_PRIVATE_KEY=<REQUIRED: same as KEEPER_PRIVATE_KEY, or dedicated deployer key>

# ── W1 wallet ───────────────────────────────────────────────────────────────
# AccountOne — used by system_keeper for W1 earnings withdrawal (if W1_WITHDRAW=true)
W1_PRIVATE_KEY=<REQUIRED: private key of 0x6512e9B5...>

# ── Telegram alerts ─────────────────────────────────────────────────────────
# Bot that sends keeper alerts to the mainnet admin channel
TELEGRAM_BOT_TOKEN=<REQUIRED: your Telegram bot token — keep this the same bot or use a dedicated one>

# Private admin channel (chat ID, e.g. -1001234567890)
TELEGRAM_CHAT_ID=<REQUIRED: your MAINNET admin channel chat ID>

# Public announcement channel (for channel_pulse.js member count pings)
TELEGRAM_ANNOUNCE_CHANNEL_ID=<REQUIRED: your MAINNET public channel ID>

# ── Stability Fund monitoring thresholds ────────────────────────────────────
# Keeper sends Telegram alert when SF balance drops below these USD values
SF_MIN_USD=200
SF_CRITICAL_USD=50

# ── Parked member monitoring ─────────────────────────────────────────────────
PARKED_WARN=50
PARKED_CRITICAL=150

# ── Rescue settings ──────────────────────────────────────────────────────────
RESCUE_THRESHOLD=5
RESCUE_BATCH=10
SF_TOPUP_AMOUNT_USD=500

# Enable autonomous rescue on mainnet
AUTO_RESCUE=true
SF_AUTOFUND=false

# ── Grace period (must match contract setting) ───────────────────────────────
PARKED_GRACE_SECS=172800

# ── W1 earnings auto-withdrawal ─────────────────────────────────────────────
# Set to true only after confirming W1 earnings are accumulating correctly
W1_WITHDRAW=false

# ── Dry-run (set true to test keeper logic without sending TXs) ─────────────
DRY_RUN=false
